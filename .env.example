# ---------------------------------------------------------------------------
# LightMap environment. Copy to .env and fill in. Validated by scripts/validate-env.ts
# and packages/config at boot. Keys are server-side unless prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL 15+; PostGIS optional in dev, required in production) ---
DATABASE_URL=postgres://lightmap:lightmap@localhost:5432/lightmap

# --- Auth.js -------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
# Passwordless email. Leave EMAIL_SERVER empty in dev: the magic link is printed to the server log.
EMAIL_SERVER=
EMAIL_FROM=LightMap <no-reply@example.com>
# Optional Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Dev/test only: a "Dev sign-in" that signs in any email without a link. Refused in production.
AUTH_DEV_LOGIN=true

# --- Stripe (test mode) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- Providers (all optional; the app runs in a labelled fixture/limited mode without them) ---
# Weather: open-meteo | fixture. Commercial use of Open-Meteo requires a paid API plan.
WEATHER_PROVIDER=open-meteo
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Geocoding: nominatim (development only, 1 req/s policy) | fixture
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=LightMap-dev (set-your-contact@example.com)
# Terrain: reearth (Mapterhorn quantized mesh, CC BY 4.0) | cesium-ion | ellipsoid
TERRAIN_PROVIDER=reearth
CESIUM_ION_TOKEN=
# Imagery: natural-earth (bundled, coarse) | cesium-ion | xyz
IMAGERY_PROVIDER=natural-earth
IMAGERY_XYZ_URL=
IMAGERY_XYZ_ATTRIBUTION=
IMAGERY_XYZ_MAX_ZOOM=18
# 3D buildings in the preview: none | cesium-osm (Cesium OSM Buildings through ion; needs CESIUM_ION_TOKEN;
# OpenStreetMap ODbL attribution is shown automatically).
BUILDINGS_PROVIDER=none
# Land cover for the ground texture (texture pack stage 2): none | xyz — a land-cover raster served
# as XYZ tiles in its published legend colours: LANDCOVER_PALETTE=worldcover (ESA WorldCover, 10 m,
# CC BY 4.0) or copernicus (Copernicus Global Land Cover, 100 m, CC BY 4.0). The tile host must
# allow cross-origin image reads (CORS) and its terms are yours to check; attribution is shown.
# Like IMAGERY_XYZ_URL, the template is sent to every browser: never put a secret key in it.
LANDCOVER_PROVIDER=none
# Example (WorldCover via ESA's Terrascope WMTS; confirm its terms and CORS first — docs/DATA_SOURCES_AND_LICENSING.md):
# LANDCOVER_XYZ_URL=https://services.terrascope.be/wmts/v2?layer=WORLDCOVER_2021_MAP&style=&tilematrixset=EPSG:3857&Service=WMTS&Request=GetTile&Version=1.0.0&Format=image/png&TileMatrix={z}&TileCol={x}&TileRow={y}
# LANDCOVER_XYZ_ATTRIBUTION=© ESA WorldCover project 2021 / Contains modified Copernicus Sentinel data (2021) processed by ESA WorldCover consortium
LANDCOVER_XYZ_URL=
LANDCOVER_XYZ_ATTRIBUTION=
LANDCOVER_XYZ_MAX_ZOOM=12
LANDCOVER_PALETTE=worldcover
# Real-reference imagery is disabled until a provider contract is approved (docs/DATA_SOURCES_AND_LICENSING.md).
REFERENCE_IMAGERY_PROVIDER=none

# --- Observability -----------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
# Product analytics (docs/PRIVACY.md §4): none | log. Defaults to log in development, none in production.
ANALYTICS_SINK=

# --- Product flags ---------------------------------------------------------------------
LIGHTMAP_SHOW_DEV_BANNER=true
